# Copy to assets/.env and fill in values.
# Get LAN IP: ipconfig getifaddr en0
DEV_HOST=localhost
API_PORT=8001

# Optional production API override
# CLOUD_URL=https://street-sync.onrender.com

# Supabase Auth — Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Optional: create an iOS OAuth client (bundle com.example.streetSync) for iPhone/macOS
# GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# Google Sign-In (native) — Web client ID from Google Cloud Console
# GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
