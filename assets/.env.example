# Copy to assets/.env and fill in values.
# Get LAN IP: ipconfig getifaddr en0
DEV_HOST=localhost
API_PORT=8001

# Optional production API override
# CLOUD_URL=https://street-sync.onrender.com

# Supabase Auth — Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable / anon key (sb_publishable_... or legacy anon JWT) — NOT the secret key
SUPABASE_ANON_KEY=your-anon-or-publishable-key
