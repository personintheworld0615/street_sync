# Copy to assets/.env and fill in values.
# Get LAN IP: ipconfig getifaddr en0
DEV_HOST=localhost
API_PORT=8001

# Optional production API override
# CLOUD_URL=https://street-sync.onrender.com

# Voice AI keys live on the API server (project root .env), not here.
# See OPENROUTER_API_KEY in ../.env.example

# Supabase Auth — Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Google Sign-In (native)
# 1) Create both OAuth clients in Google Cloud Console:
#    - Android package and iOS bundle ID are both com.example.street_sync
#    - Web: the same Google client used by the Supabase Google provider
# 2) Put the iOS URL scheme in ios/Runner/Secrets.xcconfig using the reversed client ID.
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# Web / "server" client ID — required so Supabase receives the Google ID token
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
