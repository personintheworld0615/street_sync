GOOGLE_MAPS_API_KEY=your-google-maps-api-key

// Google Sign-In (iOS) — from Google Cloud Console → Credentials
// Create an OAuth client of type "iOS" with bundle ID: com.example.streetSync
GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
// "iOS URL scheme" on that same client (reversed client id), e.g.:
// com.googleusercontent.apps.123456789-abcdef
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.YOUR_IOS_CLIENT_PREFIX
// Web client ID (same value as GOOGLE_WEB_CLIENT_ID in assets/.env)
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
