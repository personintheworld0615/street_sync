user=postgres.pefchsuewppbwoprlhze
password=[YOUR-PASSWORD]
host=aws-0-us-east-1.pooler.supabase.com
port=5432
dbname=postgres

# JWT signing secret — generate your own, never commit the real value:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-with-python-secrets-token-hex-32

# Supabase Storage (report photos)
# Project URL: Settings → API → Project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Settings → API → service_role / secret key (keep secret; server-only)
SUPABASE_SERVICE_KEY=your-service-role-key
# Flutter also needs the publishable / anon key in assets/.env as SUPABASE_ANON_KEY
# Optional here if the API should verify tokens with it as a fallback:
# SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Create public buckets with these names in Storage
SUPABASE_STORAGE_BUCKET=report-images
SUPABASE_AVATAR_BUCKET=profile-pictures

# Flutter (physical phone) — copy assets/.env.example → assets/.env
# DEV_HOST=192.168.x.x
# API_PORT=8001

# OpenRouter — voice-report title / severity / category
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Optional model override (default: openai/gpt-5.6-luna-pro)
# OPENROUTER_MODEL=openai/gpt-5.6-luna-pro
# Optional OpenRouter rankings headers
# OPENROUTER_HTTP_REFERER=https://your-app.example
# OPENROUTER_APP_TITLE=Street Sync

# Comma-separated emails allowed to change report status.
# Leave empty until you know who staff are. Nobody else can change status.
STAFF_EMAILS=

# Browser origins allowed to call the API. Mobile apps do not use CORS.
# Set this on Render to your real web origin. Do not use *.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Interactive /docs. Off automatically when RENDER=true unless set to true.
# ENABLE_API_DOCS=false
